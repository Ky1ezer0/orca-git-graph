{
  "manifestVersion": 2,
  "id": "git-graph",
  "name": "Git Graph",
  "version": "1.0.1",
  "description": "Searchable, auto-refreshing Git graph with confirmed Git actions and one-click remote fetch for local Orca workspaces.",
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.mjs",
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "storage:own"
    }
  ],
  "contributes": {
    "panels": [
      {
        "id": "git-graph",
        "title": "Git Graph",
        "icon": "branch",
        "entry": "src/panel.html",
        "ui": "html"
      }
    ],
    "customEditors": [
      {
        "id": "git-graph-diff",
        "title": "Git Graph Diff",
        "extensions": [
          ".git-graph-diff"
        ],
        "entry": "src/diff.html",
        "priority": "default",
        "contentKind": "text",
        "frame": "isolated"
      }
    ]
  },
  "cover": {
    "path": "assets/git-graph/cover.jpg",
    "alt": "Git Graph for Orca with cyan, mint, and lavender branching commit paths on a dark background."
  }
}
